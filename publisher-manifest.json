e);text-decoration: none;padding: 0.45rem 1.15rem;font-weight: 600;font-size: 0.85rem}\n\n.ticket-card.featured .ticket-btn {background: var(--purple-core);color: #ffffff}\n\n/* 终端配置清单 */\n.client-checklist {background: var(--panel-bg);border: 1.5px dashed var(--border-dash);padding: 1.5rem}\n\n.client-table {width: 100%;border-collapse: collapse;font-size: 0.9rem}\n\n.client-table th, .client-table td {padding: 0.75rem 0.5rem;text-align: left;border-bottom: 1px dashed var(--line-light)}\n\n.client-table th {font-family: ui-monospace, monospace;color: var(--text-sub);font-size: 0.8rem;font-weight: 600}\n\n/* 折叠 FAQ */\n.faq-stack {display: flex;flex-direction: column;gap: 0.75rem}\n\n.faq-item {background: var(--panel-bg);border: 1.5px dashed var(--border-dash);padding: 1rem 1.25rem}\n\n.faq-item[open] {border-color: var(--purple-core)}\n\n.faq-item summary {font-weight: 600;font-size: 0.98rem;cursor: pointer;list-style: none;display: flex;justify-content: space-between;align-items: center}\n\n.faq-item summary::-webkit-details-marker {display: none}\n\n.faq-item summary::after {content: \"+\";font-family: ui-monospace, monospace;font-size: 1.2rem;color: var(--purple-core);font-weight: bold}\n\n.faq-item[open] summary::after {content: \"-\"}\n\n.faq-content {margin-top: 0.85rem;padding-top: 0.85rem;border-top: 1px dashed var(--line-light);font-size: 0.9rem;color: var(--text-sub);line-height: 1.6}\n\n/* 底部票根标识 */\n.ticket-stub-footer {text-align: center;font-family: ui-monospace, monospace;font-size: 0.75rem;color: var(--text-sub);border-top: 2px dashed var(--border-dash);padding-top: 2rem;margin-top: 4rem}\n</style><main>\n  \n  <header class=\"poster-hero\">\n    <div class=\"poster-meta\">\n      <span>SERIES REF: 2633</span>\n      <span>ENTRY PASS // 2024-2025</span>\n      <span>SYS STATUS: RECORDED</span>\n    </div>\n\n    <h1 class=\"hero-brand\">祢豆子</h1>\n\n    <p class=\"hero-statement\">\n      网络配额与节点订阅分级配置表。去繁从简，严格依据既定数据指标划分服务梯度，满足从个人单机到团队协作的网络连通需求。\n    </p>\n\n    <div class=\"hero-shortcuts\">\n      <a href=\"#plans\" class=\"shortcut-link\">01 订阅方案核对</a>\n      <a href=\"#guide\" class=\"shortcut-link\">02 接入步骤说明</a>\n      <a href=\"#clients\" class=\"shortcut-link\">03 客户端环境备忘</a>\n      <a href=\"#faq\" class=\"shortcut-link\">04 常见事务问答</a>\n    </div>\n  </header>\n\n  \n  <section class=\"section-block\" id=\"plans\">\n    <div class=\"section-head\">\n      <span class=\"section-idx\">[SEC 01]</span>\n      <h2 class=\"section-title\">订阅套餐规格明细</h2>\n    </div>\n\n    <div class=\"ticket-stack\">\n      \n      <article class=\"ticket-card\">\n        <div class=\"ticket-header\">\n          <div class=\"ticket-title-wrap\">\n            <h3 class=\"ticket-name\">基础版</h3>\n            <span class=\"ticket-tag\">ENTRY</span>\n          </div>\n          <div class=\"ticket-pricing\">\n            <div class=\"price-main\">¥15/月</div>\n            <div class=\"price-sub\">按年付仅需 ¥150/年</div>\n          </div>\n        </div>\n        <ul class=\"spec-list\">\n          <li class=\"spec-item\">每月 100GB 极速流量</li>\n          <li class=\"spec-item\">支持 3 台设备同时在线</li>\n          <li class=\"spec-item\">解锁基础流媒体</li>\n          <li class=\"spec-item\">普通线路节点池</li>\n        </ul>\n        <div class=\"ticket-footer\">\n          <span>账期类型：月付 / 年付可选</span>\n          <a href=\"#\" class=\"ticket-btn\">选择基础版</a>\n        </div>\n      </article>\n\n      \n      <article class=\"ticket-card featured\">\n        <div class=\"ticket-header\">\n          <div class=\"ticket-title-wrap\">\n            <h3 class=\"ticket-name\">旗舰版</h3>\n            <span class=\"ticket-tag\">RECOMMENDED</span>\n          </div>\n          <div class=\"ticket-pricing\">\n            <div class=\"price-main\">¥35/月</div>\n            <div class=\"price-sub\">按年付仅需 ¥350/年</div>\n          </div>\n        </div>\n        <ul class=\"spec-list\">\n          <li class=\"spec-item\">每月 300GB 极速流量</li>\n          <li class=\"spec-item\">支持 5 台设备同时在线</li>\n          <li class=\"spec-item\">全节点原生流媒体解锁</li>\n          <li class=\"spec-item\">IPLC 专线游戏加速优化</li>\n          <li class=\"spec-item\">7x24 优先工单支持</li>\n        </ul>\n        <div class=\"ticket-footer\">\n          <span>账期类型：高频推荐方案</span>\n          <a href=\"#\" class=\"ticket-btn\">选择旗舰版</a>\n        </div>\n      </article>\n\n      \n      <article class=\"ticket-card\">\n        <div class=\"ticket-header\">\n          <div class=\"ticket-title-wrap\">\n            <h3 class=\"ticket-name\">团队版</h3>\n            <span class=\"ticket-tag\">ENTERPRISE</span>\n          </div>\n          <div class=\"ticket-pricing\">\n            <div class=\"price-main\">¥85/月</div>\n            <div class=\"price-sub\">按年付仅需 ¥850/年</div>\n          </div>\n        </div>\n        <ul class=\"spec-list\">\n          <li class=\"spec-item\">每月 1000GB 极速流量</li>\n          <li class=\"spec-item\">支持 20 台设备同时在线</li>\n          <li class=\"spec-item\">VIP 专属高带宽节点</li>\n          <li class=\"spec-item\">支持企业定制路由</li>\n          <li class=\"spec-item\">专属客户经理服务</li>\n        </ul>\n        <div class=\"ticket-footer\">\n          <span>账期类型：多人协作适配</span>\n          <a href=\"#\" class=\"ticket-btn\">选择团队版</a>\n        </div>\n      </article>\n    </div>\n  </section>\n\n  \n  <section class=\"section-block\" id=\"guide\">\n    <div class=\"section-head\">\n      <span class=\"section-idx\">[SEC 02]</span>\n      <h2 class=\"section-title\">接入核对流程</h2>\n    </div>\n\n    <div class=\"client-checklist\">\n      <div>\n        按照以下标准工序依次核验节点导入状态：\n      </div>\n      <ol>\n        <li>\n          <strong>步骤 1：获取凭证</strong> — 完成对应方案订购后，在后台凭证管理器中复制专属于您账户的节点订阅 URL。\n        </li>\n        <li>\n          <strong>步骤 2：选定运行平台</strong> — 选用您设备环境支持的通用客户端，并确保该软件支持标准订阅接口导入协议。\n        </li>\n        <li>\n          <strong>步骤 3：数据导入与路由设置</strong> — 将订阅链接贴入配置项并执行初次更新，按需求选择全局或分流规则。\n        </li>\n        <li>\n          <strong>步骤 4：联通性测试</strong> — 连通指定节点，访问外部探针核验延迟与 IP 变动，确保各项权限生效。\n        </li>\n      </ol>\n    </div>\n  </section>\n\n  \n  <section class=\"section-block\" id=\"clients\">\n    <div class=\"section-head\">\n      <span class=\"section-idx\">[SEC 03]</span>\n      <h2 class=\"section-title\">通用客户端平台兼容备忘</h2>\n    </div>\n\n    <div class=\"client-checklist\">\n      <table class=\"client-table\">\n        <thead>\n          <tr>\n            <th>操作系统</th>\n            <th>协议适配</th>\n            <th>获取说明</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td><strong>Windows</strong></td>\n            <td>Clash / v2rayN 兼容内核</td>\n            <td>请从各开源项目官方渠道或自备可信软件库获取构建</td>\n          </tr>\n          <tr>\n            <td><strong>macOS</strong></td>\n            <td>Clash Verge / Surge / Quantumult X 适配</td>\n            <td>请依据系统架构（Apple Silicon / Intel）选择对应的发行版</td>\n          </tr>\n          <tr>\n            <td><strong>Android</strong></td>\n            <td>Clash Meta / v2rayNG 标准支持</td>\n            <td>可在 GitHub Releases 或 Google Play 等受信任应用商店下载</td>\n          </tr>\n          <tr>\n            <td><strong>iOS / iPadOS</strong></td>\n            <td>Shadowrocket / Loon / Stash 对应接口</td>\n            <td>请在非受限区域的 App Store 登录并获取相关独立工具</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </section>\n\n  \n  <section class=\"section-block\" id=\"faq\">\n    <div class=\"section-head\">\n      <span class=\"section-idx\">[SEC 04]</span>\n      <h2 class=\"section-title\">常见问题清单</h2>\n    </div>\n\n    <div class=\"faq-stack\">\n      <details class=\"faq-item\">\n        <summary>基础版、旗舰版与团队版的设备连接数如何计入？</summary>\n        <div class=\"faq-content\">\n          系统以同一物理时刻处于活跃会话状态的 IP 或鉴权连接数为准。基础版上限为 3 台，旗舰版上限为 5 台，团队版上限为 20 台。超过上限时，后发起的连接将受排队限制或暂时断开。\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>每月分配的极速流量是否在到期后结转？</summary>\n        <div class=\"faq-content\">\n          配额按订阅周期重置。每个账单周期起始日（按月或按年）系统将重新载入对应的 100GB、300GB 或 1000GB 额度，上一周期的剩余未用配额不会滚存至下一周期。\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>如何获取官方定制的客户端应用下载？</summary>\n        <div class=\"faq-content\">\n          祢豆子目前基于标准开放协议运行，不直接提供专属绑定的私有封装安装包。用户可自由配置行业主流的开源或第三方网络适配工具，订阅链接符合通用标准解析规范。\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>旗舰版的“IPLC 专线游戏加速优化”包含什么特性？</summary>\n        <div class=\"faq-content\">\n          该特性面向延迟敏感型业务。订阅旗舰版的用户将在节点池中分配专线接入端口，规避公网抖动与拥塞，以保障联机游戏及实时数据交互的稳定连通。\n        </div>\n      </details>\n    </div>\n  </section>\n\n  <footer class=\"ticket-stub-footer\">\n    <div>END OF TICKET // 祢豆子 SERVICE SUMMARY</div>\n    <div>ALL SPECIFICATIONS ARE SUBJECT TO THE SERVICE AGREEMENT.</div>\n  </footer>\n</main>",
